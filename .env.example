# Database
DATABASE_URL="postgres://postgres:postgres@localhost:5432/yummy_chat"

# Authentication (required)
BETTER_AUTH_SECRET="change-me-to-a-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# LLM Provider (optional - only needed for LLM features)
LLM_PROVIDER_API_KEY=""

# OpenAI (optional - when set, replaces the fake LLM provider)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-nano"

# Memory V2 (optional; MEMORY_API_KEY falls back to OPENAI_API_KEY)
MEMORY_API_KEY=""
MEMORY_BASE_URL=""
MEMORY_EXTRACTION_MODEL=""
MEMORY_EMBEDDING_MODEL=""
MEMORY_V2_ENABLED=""

# BYOK Encryption (required for user-provided API key storage)
# Generate: openssl rand -hex 32
USER_API_KEY_ENCRYPTION_SECRET=""

# MCP client (optional; keep false in production unless private endpoints are trusted)
MCP_ALLOW_PRIVATE_NETWORKS="false"
# Allow authenticated users to execute local stdio MCP commands as the backend OS account
MCP_ALLOW_LOCAL_COMMANDS="false"

# Application
APP_ENV="development"
